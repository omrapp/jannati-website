{
  "name": "jannati-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:extract": "node --experimental-strip-types scripts/seed/extract.ts",
    "seed:fetch-images": "node --experimental-strip-types scripts/seed/fetch-missing-images.ts",
    "seed:images": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/seed/images.ts",
    "seed:load": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/seed/load.ts",
    "seed:content-pages": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/seed/content-pages.ts",
    "seed:translate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/seed/translate.ts",
    "seed:brand-logos": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/seed/brand-logos.ts",
    "db:link": "supabase link --project-ref $(node --env-file-if-exists=.env --env-file-if-exists=.env.local -p 'process.env.SUPABASE_PROJECT_REF')",
    "db:push": "supabase db push --linked",
    "db:pull": "supabase db pull --linked",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.73",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "next": "16.3.8",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
