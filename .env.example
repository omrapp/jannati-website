# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (hosted project — no local Docker stack) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project ref from the dashboard URL. Used by `npm run db:link`, CLI only.
SUPABASE_PROJECT_REF=

# --- Payments (Phase 2) ---
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_ENV=sandbox
TAP_SECRET_KEY=
TAP_PUBLISHABLE_KEY=

# --- Notifications (Phase 4) ---
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Seed pipeline (one-off, local only) ---
ANTHROPIC_API_KEY=
